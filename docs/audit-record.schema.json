{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kea IP Audit record",
  "description": "A complete record emitted by the default all-fields JSON formatter.",
  "type": "object",
  "required": ["timestamp", "event", "schema-version", "ip-address"],
  "additionalProperties": false,
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "event": {
      "type": "string",
      "enum": ["lease-assign", "lease-renew", "lease-delete", "lease-release", "lease-decline", "lease-expire"]
    },
    "schema-version": { "const": "1.0.0" },
    "server": { "type": "string" },
    "ip-address": { "type": "string" },
    "hw-address": { "type": "string" },
    "client-id": { "type": "string" },
    "hostname": { "type": "string" },
    "vendor-class": { "type": "string" },
    "vendor-class-text": { "type": "string" },
    "user-class": { "type": "string" },
    "subnet-id": { "type": "integer", "minimum": 0 },
    "pop": { "type": "string" },
    "site": { "type": "string" },
    "valid-lifetime": { "type": "integer", "minimum": 0 },
    "lease-expires": { "type": "string", "format": "date-time" },
    "message-type": { "type": "string" },
    "transaction-id": { "type": "string" },
    "interface": { "type": "string" },
    "giaddr": { "type": "string" },
    "relay-address": { "type": "string" },
    "circuit-id": { "type": "string" },
    "circuit-id-text": { "type": "string" },
    "remote-id": { "type": "string" },
    "remote-id-text": { "type": "string" },
    "subscriber-id": { "type": "string" },
    "subscriber-id-text": { "type": "string" },
    "link-selection": { "type": "string" },
    "relay-suboptions": { "type": "string" },
    "relay-flags": { "type": "string" },
    "relay-vendor-specific": { "type": "string" },
    "address-family": { "type": "string", "enum": ["IPv4", "IPv6"] },
    "lease-type": { "type": "string", "enum": ["", "IA_NA", "IA_TA", "IA_PD"] },
    "iaid": { "type": ["integer", "null"], "minimum": 0 },
    "duid": { "type": "string" },
    "prefix-length": { "type": ["integer", "null"], "minimum": 0, "maximum": 128 },
    "relay-interface-id": { "type": "string" },
    "relay-interface-id-text": { "type": "string" },
    "relay-link-address": { "type": "string" }
  }
}